rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidRoomCode(code) {
      return code is string && code.size() >= 3 && code.size() <= 24 && code.matches('^[A-Z0-9_\\-]+$');
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // 3. Entity Validation Blueprints
    function isValidUserPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidString(data.email, 3, 254);
    }

    function isValidCompetitionRoom(data, roomCode) {
      return data.keys().hasAll([
          'code',
          'ownerId',
          'player1Uid',
          'player1Name',
          'player2Uid',
          'player2Name',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'code',
          'ownerId',
          'player1Uid',
          'player1Name',
          'player2Uid',
          'player2Name',
          'createdAt',
          'updatedAt'
        ])
        && isValidRoomCode(data.code)
        && data.code == roomCode
        && isValidId(data.ownerId)
        && isValidId(data.player1Uid)
        && isValidString(data.player1Name, 1, 30)
        && (data.player2Uid == '' || isValidId(data.player2Uid))
        && isValidString(data.player2Name, 1, 30)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMemberProgress(data, roomCode, memberId) {
      return data.keys().hasAll([
          'uid',
          'roomCode',
          'role',
          'name',
          'xp',
          'duelHighScore',
          'duelBestTimeSec',
          'duelsPlayed',
          'lastActiveDate',
          'completedStages',
          'lessonReviews',
          'completedMorningPackets',
          'completedBlocks',
          'masteredCards',
          'cardReviews',
          'solvedExercises',
          'activityDates',
          'recentDuels',
          'recentActivities',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'roomCode',
          'role',
          'name',
          'xp',
          'duelHighScore',
          'duelBestTimeSec',
          'duelsPlayed',
          'lastActiveDate',
          'completedStages',
          'lessonReviews',
          'completedMorningPackets',
          'completedBlocks',
          'masteredCards',
          'cardReviews',
          'solvedExercises',
          'activityDates',
          'recentDuels',
          'recentActivities',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == memberId
        && data.uid == request.auth.uid
        && isValidRoomCode(data.roomCode)
        && data.roomCode == roomCode
        && (data.role == 'player1' || data.role == 'player2')
        && isValidString(data.name, 1, 30)
        && data.xp is number && data.xp >= 0 && data.xp <= 1000000
        && data.duelHighScore is number && data.duelHighScore >= 0 && data.duelHighScore <= 100
        && data.duelBestTimeSec is number && data.duelBestTimeSec >= 0 && data.duelBestTimeSec <= 86400
        && data.duelsPlayed is number && data.duelsPlayed >= 0 && data.duelsPlayed <= 10000
        && isValidString(data.lastActiveDate, 8, 16)
        && data.completedStages is map && data.completedStages.size() <= 300
        && data.lessonReviews is map && data.lessonReviews.size() <= 100
        && data.completedMorningPackets is map && data.completedMorningPackets.size() <= 40
        && data.completedBlocks is map && data.completedBlocks.size() <= 200
        && data.masteredCards is map && data.masteredCards.size() <= 400
        && data.cardReviews is map && data.cardReviews.size() <= 400
        && data.solvedExercises is map && data.solvedExercises.size() <= 100
        && data.activityDates is list && data.activityDates.size() <= 40
        && (data.activityDates.size() == 0 || data.activityDates[0] is string)
        && data.recentDuels is list && data.recentDuels.size() <= 15
        && (data.recentDuels.size() == 0 || data.recentDuels[0] is map)
        && data.recentActivities is list && data.recentActivities.size() <= 25
        && (data.recentActivities.size() == 0 || data.recentActivities[0] is map)
        && data.updatedAt is timestamp;
    }

    function isRoomParticipant(roomCode) {
      let roomData = get(/databases/$(database)/documents/rooms/$(roomCode)).data;
      return roomData.player1Uid == request.auth.uid || roomData.player2Uid == request.auth.uid;
    }

    function matchesRoomRole(roomCode, role) {
      let roomData = get(/databases/$(database)/documents/rooms/$(roomCode)).data;
      return (role == 'player1' && roomData.player1Uid == request.auth.uid)
        || (role == 'player2' && roomData.player2Uid == request.auth.uid);
    }

    // 4. Isolated Private User Profile
    match /users/{userId}/private/profile {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email']);
    }

    // 5. Competition Room Metadata & Subcollection Members
    match /rooms/{roomCode} {
      allow get: if isSignedIn()
        && isValidRoomCode(roomCode)
        && (
          resource == null
          || existing().player1Uid == request.auth.uid
          || existing().player2Uid == request.auth.uid
          || existing().player2Uid == ''
        );

      allow list: if isSignedIn()
        && (resource.data.player1Uid == request.auth.uid || resource.data.player2Uid == request.auth.uid);

      allow create: if isSignedIn()
        && isValidRoomCode(roomCode)
        && isValidCompetitionRoom(incoming(), roomCode)
        && incoming().ownerId == request.auth.uid
        && incoming().player1Uid == request.auth.uid
        && incoming().player2Uid == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidRoomCode(roomCode)
        && isValidCompetitionRoom(incoming(), roomCode)
        && incoming().code == existing().code
        && incoming().ownerId == existing().ownerId
        && incoming().player1Uid == existing().player1Uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          // Action 1: Player 2 joins open slot
          (
            existing().player2Uid == ''
            && existing().player1Uid != request.auth.uid
            && incoming().player2Uid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['player2Uid', 'player2Name', 'updatedAt'])
          )
          // Action 2: Player 1 updates their own display name
          || (
            existing().player1Uid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['player1Name', 'updatedAt'])
          )
          // Action 3: Player 2 updates their own display name
          || (
            existing().player2Uid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['player2Name', 'updatedAt'])
          )
          // Action 4: Player 2 leaves room
          || (
            existing().player2Uid == request.auth.uid
            && incoming().player2Uid == ''
            && incoming().diff(existing()).affectedKeys().hasOnly(['player2Uid', 'updatedAt'])
          )
        );

      match /members/{memberId} {
        allow get: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(memberId)
          && (memberId == request.auth.uid || isRoomParticipant(roomCode));

        allow create: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(memberId)
          && memberId == request.auth.uid
          && isValidMemberProgress(incoming(), roomCode, memberId)
          && matchesRoomRole(roomCode, incoming().role)
          && incoming().updatedAt == request.time;

        allow update: if isSignedIn()
          && isValidRoomCode(roomCode)
          && isValidId(memberId)
          && memberId == request.auth.uid
          && isValidMemberProgress(incoming(), roomCode, memberId)
          && isRoomParticipant(roomCode)
          && incoming().uid == existing().uid
          && incoming().roomCode == existing().roomCode
          && incoming().role == existing().role
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'xp',
            'duelHighScore',
            'duelBestTimeSec',
            'duelsPlayed',
            'lastActiveDate',
            'completedStages',
            'lessonReviews',
            'completedMorningPackets',
            'completedBlocks',
            'masteredCards',
            'cardReviews',
            'solvedExercises',
            'activityDates',
            'recentDuels',
            'recentActivities',
            'updatedAt'
          ]);
      }
    }
  }
}
