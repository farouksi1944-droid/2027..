rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // 3. Entity Validation Blueprints
    function isValidUserPrivateProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'createdAt'])
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidString(data.email, 3, 254);
    }

    function isValidParticipantProgress(data, participantId) {
      return data.keys().hasAll([
          'uid',
          'visibility',
          'name',
          'xp',
          'duelHighScore',
          'duelBestTimeSec',
          'duelsPlayed',
          'lastActiveDate',
          'completedStages',
          'lessonReviews',
          'completedMorningPackets',
          'completedBlocks',
          'masteredCards',
          'cardReviews',
          'solvedExercises',
          'activityDates',
          'recentDuels',
          'recentActivities',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'visibility',
          'name',
          'xp',
          'duelHighScore',
          'duelBestTimeSec',
          'duelsPlayed',
          'lastActiveDate',
          'completedStages',
          'lessonReviews',
          'completedMorningPackets',
          'completedBlocks',
          'masteredCards',
          'cardReviews',
          'solvedExercises',
          'activityDates',
          'recentDuels',
          'recentActivities',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == participantId
        && data.uid == request.auth.uid
        && data.visibility == 'public_competition'
        && isValidString(data.name, 1, 30)
        && data.xp is number && data.xp >= 0 && data.xp <= 1000000
        && data.duelHighScore is number && data.duelHighScore >= 0 && data.duelHighScore <= 100
        && data.duelBestTimeSec is number && data.duelBestTimeSec >= 0 && data.duelBestTimeSec <= 86400
        && data.duelsPlayed is number && data.duelsPlayed >= 0 && data.duelsPlayed <= 10000
        && isValidString(data.lastActiveDate, 8, 16)
        && data.completedStages is map && data.completedStages.size() <= 300
        && data.lessonReviews is map && data.lessonReviews.size() <= 100
        && data.completedMorningPackets is map && data.completedMorningPackets.size() <= 40
        && data.completedBlocks is map && data.completedBlocks.size() <= 200
        && data.masteredCards is map && data.masteredCards.size() <= 400
        && data.cardReviews is map && data.cardReviews.size() <= 400
        && data.solvedExercises is map && data.solvedExercises.size() <= 100
        && data.activityDates is list && data.activityDates.size() <= 40
        && (data.activityDates.size() == 0 || data.activityDates[0] is string)
        && data.recentDuels is list && data.recentDuels.size() <= 15
        && (data.recentDuels.size() == 0 || data.recentDuels[0] is map)
        && data.recentActivities is list && data.recentActivities.size() <= 25
        && (data.recentActivities.size() == 0 || data.recentActivities[0] is map)
        && data.updatedAt is timestamp;
    }

    // 4. Isolated Private User Profile (PII)
    match /users/{userId}/private/profile {
      allow get: if isSignedIn() && isValidId(userId) && userId == request.auth.uid;
      allow create: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if isSignedIn()
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUserPrivateProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['email']);
    }

    // 5. Single-Account Public Competition Leaderboard
    match /participants/{participantId} {
      allow get: if isSignedIn()
        && isValidId(participantId)
        && (participantId == request.auth.uid || existing().visibility == 'public_competition');

      allow list: if isSignedIn()
        && resource.data.visibility == 'public_competition';

      allow create: if isSignedIn()
        && isValidId(participantId)
        && participantId == request.auth.uid
        && isValidParticipantProgress(incoming(), participantId)
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(participantId)
        && participantId == request.auth.uid
        && isValidParticipantProgress(incoming(), participantId)
        && incoming().uid == existing().uid
        && incoming().visibility == existing().visibility
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'xp',
          'duelHighScore',
          'duelBestTimeSec',
          'duelsPlayed',
          'lastActiveDate',
          'completedStages',
          'lessonReviews',
          'completedMorningPackets',
          'completedBlocks',
          'masteredCards',
          'cardReviews',
          'solvedExercises',
          'activityDates',
          'recentDuels',
          'recentActivities',
          'updatedAt'
        ]);
    }
  }
}
