{
  "entities": {
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private authenticated user metadata (PII isolated from shared competition rooms).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "createdAt": {
          "type": "object",
          "description": "Firestore server timestamp"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "CompetitionRoom": {
      "title": "CompetitionRoom",
      "description": "Two-student Term 1 study competition room linking Farouk and Saeed.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[A-Z0-9_-]+$"
        },
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "player1Uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "player1Name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "player2Uid": {
          "type": "string",
          "maxLength": 128
        },
        "player2Name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "createdAt": {
          "type": "object"
        },
        "updatedAt": {
          "type": "object"
        }
      },
      "required": [
        "code",
        "ownerId",
        "player1Uid",
        "player1Name",
        "player2Uid",
        "player2Name",
        "createdAt",
        "updatedAt"
      ]
    },
    "RoomMemberProgress": {
      "title": "RoomMemberProgress",
      "description": "Individual student study progress, spaced-repetition reviews, XP, and recent competition history.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "roomCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[A-Z0-9_-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["player1", "player2"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "xp": {
          "type": "number"
        },
        "duelHighScore": {
          "type": "number"
        },
        "duelBestTimeSec": {
          "type": "number"
        },
        "duelsPlayed": {
          "type": "number"
        },
        "lastActiveDate": {
          "type": "string",
          "maxLength": 16
        },
        "completedStages": {
          "type": "object"
        },
        "lessonReviews": {
          "type": "object"
        },
        "completedMorningPackets": {
          "type": "object"
        },
        "completedBlocks": {
          "type": "object"
        },
        "masteredCards": {
          "type": "object"
        },
        "cardReviews": {
          "type": "object"
        },
        "solvedExercises": {
          "type": "object"
        },
        "activityDates": {
          "type": "array"
        },
        "recentDuels": {
          "type": "array"
        },
        "recentActivities": {
          "type": "array"
        },
        "updatedAt": {
          "type": "object"
        }
      },
      "required": [
        "uid",
        "roomCode",
        "role",
        "name",
        "xp",
        "duelHighScore",
        "duelBestTimeSec",
        "duelsPlayed",
        "lastActiveDate",
        "completedStages",
        "lessonReviews",
        "completedMorningPackets",
        "completedBlocks",
        "masteredCards",
        "cardReviews",
        "solvedExercises",
        "activityDates",
        "recentDuels",
        "recentActivities",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/private/profile": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Isolated private user profile holding verified email address."
    },
    "/rooms/{roomCode}": {
      "schema": { "$ref": "#/entities/CompetitionRoom" },
      "description": "Two-player study competition room connecting Farouk and Saeed across devices."
    },
    "/rooms/{roomCode}/members/{memberId}": {
      "schema": { "$ref": "#/entities/RoomMemberProgress" },
      "description": "Per-account study progress and spaced repetition state readable by the room opponent for live competition."
    }
  }
}
