{
  "entities": {
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private authenticated user metadata (PII isolated from public competition leaderboard).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "createdAt": {
          "type": "object",
          "description": "Firestore server timestamp"
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "ParticipantProgress": {
      "title": "ParticipantProgress",
      "description": "Single-account student study progress, scientific exercises, mastery stats, and leaderboard competition data.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "visibility": {
          "type": "string",
          "enum": ["public_competition"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "xp": {
          "type": "number"
        },
        "duelHighScore": {
          "type": "number"
        },
        "duelBestTimeSec": {
          "type": "number"
        },
        "duelsPlayed": {
          "type": "number"
        },
        "lastActiveDate": {
          "type": "string",
          "maxLength": 16
        },
        "completedStages": {
          "type": "object"
        },
        "lessonReviews": {
          "type": "object"
        },
        "completedMorningPackets": {
          "type": "object"
        },
        "completedBlocks": {
          "type": "object"
        },
        "masteredCards": {
          "type": "object"
        },
        "cardReviews": {
          "type": "object"
        },
        "solvedExercises": {
          "type": "object"
        },
        "activityDates": {
          "type": "array"
        },
        "recentDuels": {
          "type": "array"
        },
        "recentActivities": {
          "type": "array"
        },
        "updatedAt": {
          "type": "object"
        }
      },
      "required": [
        "uid",
        "visibility",
        "name",
        "xp",
        "duelHighScore",
        "duelBestTimeSec",
        "duelsPlayed",
        "lastActiveDate",
        "completedStages",
        "lessonReviews",
        "completedMorningPackets",
        "completedBlocks",
        "masteredCards",
        "cardReviews",
        "solvedExercises",
        "activityDates",
        "recentDuels",
        "recentActivities",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/private/profile": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Isolated private user profile holding verified email address."
    },
    "/participants/{participantId}": {
      "schema": { "$ref": "#/entities/ParticipantProgress" },
      "description": "Single-account progress documents readable across authenticated participants for live points comparison."
    }
  }
}
